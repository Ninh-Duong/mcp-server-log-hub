# Optional settings for mcp-server-log-hub. Copy to .env (Git-ignored); variables set by the MCP client win.

# Folders, relative to the project root.
LOG_DIR=./logs
AI_CONTEXT_DIR=./ai-context

# OpenObserve environment to use in MCP mode: dev, stg or prod (reads config/openobserve.<env>.env).
# Without it, the DEV account is used when config/openobserve.dev.env has a URL.
OPENOBSERVE_ENV=dev

# Time zone of ai-context export folder names, any IANA zone (e.g. Europe/Berlin); log timestamps inside stay UTC.
AI_CONTEXT_TIME_ZONE=UTC

# Provider accounts live in config/: openobserve.<dev|stg|prod>.env and seq.env (created from the examples there).
