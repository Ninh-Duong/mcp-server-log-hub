# MCP Server Settings
LOG_LEVEL=info
LOG_DIR=./logs

# Seq Provider Settings
# URL of your Seq instance (e.g., https://seq.internal.domain or http://localhost:5341)
SEQ_SERVER_URL=http://localhost:5341
# Seq API Key with read permissions
SEQ_API_KEY=

# Observe (OBS) Provider Settings
# Observe Customer ID
OBSERVE_CUSTOMER_ID=
# Observe Bearer Token or API Token
OBSERVE_TOKEN=
# Observe domain (defaults to observeinc.com)
OBSERVE_DOMAIN=observeinc.com
