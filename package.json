{
  "name": "mcp-server-log-hub",
  "version": "1.0.0",
  "description": "Unified MCP server for Seq and OpenObserve log search",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mcp-server-log-hub": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "start": "node start.mjs",
    "cli": "node start.mjs --cli",
    "preflight": "node start.mjs --preflight",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "logging",
    "observability",
    "seq",
    "openobserve"
  ],
  "author": "",
  "license": "MIT",
  "files": [
    "dist",
    "!dist/tests",
    "config/*.example"
  ]
}
